#!/usr/bin/env bash
# Installation automatique de Docker
set -euo pipefail

SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
USER_NAME="${SUDO_USER:-$USER}"

# curl : installé automatiquement si absent
if ! command -v curl >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    $SUDO apt-get update -qq >/dev/null && $SUDO apt-get install -y -qq curl >/dev/null
  elif command -v dnf >/dev/null 2>&1; then
    $SUDO dnf install -y -q curl >/dev/null
  else
    $SUDO yum install -y -q curl >/dev/null
  fi
  echo "ℹ curl n'était pas installé : il a été installé."
fi

# Docker
curl -fsSL https://get.docker.com | $SUDO sh >/dev/null 2>&1
$SUDO systemctl enable --now docker
[ "$USER_NAME" != "root" ] && $SUDO usermod -aG docker "$USER_NAME"

cat <<MSG

✅ Docker installé : $(docker --version)

Prochaines étapes :
  1. Reconnecte-toi (ou : newgrp docker) pour utiliser docker sans sudo
  2. Teste           : docker run hello-world
  3. Voir les conteneurs : docker ps -a
  4. Docker Compose  : docker compose up -d
  5. Doc             : https://docs.docker.com/get-started/
MSG
